{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shiyamprimetrade-sketch/Slickk-OS/blob/planning/slickk-os-foundation/benchmarks/schema.json",
  "title": "Slickk-OS P0-007 benchmark observations",
  "type": "object",
  "required": ["schema_version", "observations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_kind", "variant", "workload", "metric", "unit", "value", "iteration", "session_id", "timestamp_utc", "evidence_ref", "device_id", "device_model", "device_type", "os_build", "app_version", "test_version", "network", "brightness_pct", "refresh_hz", "start_temp_c", "battery_soc_pct", "profile_id", "exposure_s"],
      "properties": {
        "dataset_kind": {"enum": ["synthetic", "device"]},
        "variant": {"enum": ["android", "slickk-os"]},
        "workload": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "metric": {"type": "string"},
        "unit": {"type": "string"},
        "value": {"type": "number", "minimum": 0},
        "iteration": {"type": "integer", "minimum": 1},
        "session_id": {"type": "string", "minLength": 1},
        "timestamp_utc": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "device_id": {"type": "string", "minLength": 1},
        "device_model": {"type": "string", "minLength": 1},
        "device_type": {"enum": ["physical", "emulator"]},
        "os_build": {"type": "string", "minLength": 1},
        "app_version": {"type": "string", "minLength": 1},
        "test_version": {"type": "string", "minLength": 1},
        "network": {"enum": ["airplane", "wifi", "cellular", "offline", "ethernet"]},
        "brightness_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "refresh_hz": {"type": "number", "exclusiveMinimum": 0},
        "start_temp_c": {"type": "number", "minimum": -30, "maximum": 90},
        "battery_soc_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "profile_id": {"type": "string", "minLength": 1},
        "exposure_s": {"type": "number", "minimum": 0}
      }
    }
  },
  "x-metrics": {
    "startup_cold_ms": {"unit": "ms", "better": "lower", "aggregate": "p95", "target_pct": 20},
    "startup_warm_ms": {"unit": "ms", "better": "lower", "aggregate": "p95", "target_pct": 20},
    "ui_action_ms": {"unit": "ms", "better": "lower", "aggregate": "p95", "target_pct": 20},
    "frame_time_ms": {"unit": "ms", "better": "lower", "aggregate": "p95", "target_pct": 0},
    "frame_jank_pct": {"unit": "percent", "better": "lower", "aggregate": "median", "target_pct": 20},
    "memory_pss_kib": {"unit": "KiB", "better": "lower", "aggregate": "median", "target_pct": 0},
    "allocation_bytes": {"unit": "bytes", "better": "lower", "aggregate": "median", "target_pct": 0},
    "idle_drain_pct_per_hour": {"unit": "percent/hour", "better": "lower", "aggregate": "median", "target_pct": 15},
    "energy_mwh": {"unit": "mWh", "better": "lower", "aggregate": "median", "target_pct": 15},
    "background_energy_mwh": {"unit": "mWh", "better": "lower", "aggregate": "median", "target_pct": 0},
    "thermal_peak_c": {"unit": "C", "better": "lower", "aggregate": "median", "target_pct": 0},
    "crash_count": {"unit": "count", "better": "lower", "aggregate": "p95", "target_pct": 0},
    "anr_count": {"unit": "count", "better": "lower", "aggregate": "p95", "target_pct": 0},
    "recovery_ms": {"unit": "ms", "better": "lower", "aggregate": "p95", "target_pct": 0},
    "ux_steps": {"unit": "count", "better": "lower", "aggregate": "median", "target_pct": 25},
    "ux_task_ms": {"unit": "ms", "better": "lower", "aggregate": "p95", "target_pct": 20},
    "accessibility_pass_pct": {"unit": "percent", "better": "higher", "aggregate": "median", "target_pct": 0},
    "compatibility_pass_pct": {"unit": "percent", "better": "higher", "aggregate": "median", "target_pct": 0},
    "privacy_violation_count": {"unit": "count", "better": "lower", "aggregate": "p95", "target_pct": 0}
  }
}
