<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="online.slickk.os">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="32" />
  <queries><intent>
    <action android:name="android.intent.action.MAIN" />
    <category android:name="android.intent.category.LAUNCHER" />
  </intent></queries>
  <application android:label="Slickk OS" android:allowBackup="false"
               android:usesCleartextTraffic="false"
               android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".HomeActivity" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.HOME" />
        <category android:name="android.intent.category.DEFAULT" />
      </intent-filter>
    </activity>
  </application>
</manifest>
